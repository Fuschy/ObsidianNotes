views:
  - type: table
    name: Sicht
    filters:
      and:
        - file.inFolder("Bewerbungen")
        - file.name != "Bewerbungen.base"
        - file.name != "Fragen für Bewerbungsgespräche"
    order:
      - file.name
      - title
      - stand
      - created
      - description
      - source
      - tags
